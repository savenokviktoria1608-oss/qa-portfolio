{
  "info": {
    "name": "BugRank · PayFlow API",
    "description": "Коллекция проверок REST API платежей стенда «PayFlow» (bugrank.gripe): создание платежа, валидация, идемпотентность, возвраты, баланс. Запросы выполнялись во встроенной консоли стенда. Перед запуском задайте baseUrl. Тестовые карты: 4242424242424242 - успех, 4000000000000002 - отказ.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cardOk",
      "value": "4242424242424242",
      "type": "string"
    },
    {
      "key": "cardDecline",
      "value": "4000000000000002",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Создание платежа",
      "item": [
        {
          "name": "POST /payments - успешная карта",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('статус платежа succeeded', () => pm.expect(body.status).to.eql('succeeded'));",
                  "pm.test('полный номер карты не возвращается', () => pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('cardOk')));",
                  "pm.collectionVariables.set('paymentId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1999,\n  \"currency\": \"USD\",\n  \"card_number\": \"{{cardOk}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            }
          }
        },
        {
          "name": "POST /payments - карта отказа",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус 402', () => pm.response.to.have.status(402));",
                  "pm.test('код ошибки card_declined', () => pm.expect(pm.response.text()).to.include('card_declined'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1999,\n  \"currency\": \"USD\",\n  \"card_number\": \"{{cardDecline}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            }
          }
        },
