    {
      "key": "baseUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "foreignTaskId",
      "value": "",
      "type": "string"
    }
  ],
