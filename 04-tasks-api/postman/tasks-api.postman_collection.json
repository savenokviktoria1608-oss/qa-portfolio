                  "pm.test('статус 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('не больше limit элементов', () => pm.expect(body.items.length).to.be.at.most(5));",
                  "pm.test('есть общее количество', () => pm.expect(body).to.have.property('total'));"
